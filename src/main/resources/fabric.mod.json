{
	"schemaVersion": 1,
	"id": "sg-compass",
	"version": "${version}",
	"name": "SG Compass",
	"description": "A simple mod to display the player coordinates and biome when a compass is in it's inventory.",
	"authors": [
		"ArielM24"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/sg-compass/sg-compass.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.sg.compass.SGCompass"
		],
		"client": [
			"com.sg.compass.SGCompassClient"
		]
	},
	"mixins": [
		"sg-compass.mixins.json",
		{
			"config": "sg-compass.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.4",
		"minecraft": "~1.21.6",
		"java": ">=21",
		"fabric-api": ">=0.127.0+1.21.6"
	},
	"suggests": {
		"another-mod": "*"
	}
}